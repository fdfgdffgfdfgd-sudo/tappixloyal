# Copy to .env for local use. Generate a unique JWT_SECRET before deployment.
POSTGRES_DB=tappix
POSTGRES_USER=tappix
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_ENV=development
JWT_SECRET=replace-with-at-least-32-random-bytes
INTEGRATION_ENCRYPTION_KEY=replace-with-a-separate-32-byte-random-key
REDIS_ADDR=redis:6379
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=Tappix <noreply@tappix.kz>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=false
APP_URL=http://localhost:8088
TAPPIX_PORT=8088
API_PORT=8080

# Meta WhatsApp Cloud API. In production set OTP_DEV_MODE=false.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=tappix_login_code
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
OTP_DEV_MODE=true
METRICS_TOKEN=replace-with-monitoring-token-in-production
