# Copy to .env.production on the server, chmod 600, and replace every REQUIRED value.
APP_ENV=production
APP_DOMAIN=app.example.com
APP_URL=https://app.example.com
API_URL=https://app.example.com/api/v1
WEB_ORIGIN=https://app.example.com
ACME_EMAIL=ops@example.com
TAPPIX_API_IMAGE=ghcr.io/OWNER/REPOSITORY/api:REQUIRED_GIT_SHA
TAPPIX_WEB_IMAGE=ghcr.io/OWNER/REPOSITORY/web:REQUIRED_GIT_SHA

# Prefer managed PostgreSQL/Redis. Production PostgreSQL must enforce TLS.
DATABASE_URL=postgres://REQUIRED_USER:REQUIRED_PASSWORD@REQUIRED_DB_HOST:5432/REQUIRED_DB?sslmode=require
REDIS_ADDR=REQUIRED_REDIS_HOST:6379
REDIS_PASSWORD=REQUIRED_REDIS_PASSWORD
JWT_SECRET=REQUIRED_RANDOM_64_CHARS
INTEGRATION_ENCRYPTION_KEY=REQUIRED_RANDOM_64_CHARS
METRICS_TOKEN=REQUIRED_RANDOM_32_CHARS
RELEASE_SHA=REQUIRED_GIT_SHA
MIGRATION_VERSION=45
OTP_DEV_MODE=false
LOG_LEVEL=info

# Optional provider group: leave every value blank until SMTP is available.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# Optional provider group: leave every value blank until Meta credentials exist.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_OTP_TEMPLATE=tappix_login_code
WHATSAPP_GRAPH_VERSION=v23.0

# Backup policy.
BACKUP_DIR=/var/backups/tappix
BACKUP_RETENTION_DAYS=14
